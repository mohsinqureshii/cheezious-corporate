# ---------------------------------------------------------------------------
# Cheezious Corporate Digital Platform — environment template
# Copy to .env and fill in. NEVER commit a real .env file.
# Every variable here is validated at boot by @cheezious/config (Zod).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# NODE_ENV is deliberately NOT set here. Next.js and the test runner set it
# themselves, and forcing it from .env makes `next build` produce a development
# build, which fails while prerendering error pages.
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------
# PostgreSQL 14+ required. The migrations create the pg_trgm and unaccent
# extensions, so the database user must be allowed to create them.
DATABASE_URL=postgresql://cheezious:cheezious@localhost:5432/cheezious_corporate?schema=public
# Direct (non-pooled) URL used by `prisma migrate`. When you are not behind a
# connection pooler such as PgBouncer, set it to the same value as DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://cheezious:cheezious@localhost:5432/cheezious_corporate?schema=public

# --- Redis (optional; in-memory fallback used when unset) ------------------
REDIS_URL=

# --- API -------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000

# --- Applications ----------------------------------------------------------
CORPORATE_WEB_URL=http://localhost:3000
CMS_URL=http://localhost:3001

# --- Security --------------------------------------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-at-least-32-characters-of-random-data
PREVIEW_SECRET=replace-me-with-at-least-32-characters-of-random-data
REVALIDATE_SECRET=replace-me-with-at-least-32-characters-of-random-data
# Server-to-server key the Next.js apps use to reach internal API routes.
INTERNAL_API_KEY=replace-me-with-at-least-32-characters-of-random-data

SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120
PASSWORD_RESET_TTL_MINUTES=60
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MINUTES=15

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Storage ---------------------------------------------------------------
# driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.storage
# Storage keys already carry their own prefix (media/..., private/...),
# so this is the origin plus the serving path, without repeating it.
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/files

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

MAX_UPLOAD_MB=25
MAX_APPLICATION_UPLOAD_MB=10

# --- Email (optional; console transport used when unset) -------------------
SMTP_URL=
MAIL_FROM="Cheezious Corporate <no-reply@example.com>"

# --- Public site -----------------------------------------------------------
# The published origin, used for canonical URLs, hreflang, JSON-LD and the
# sitemap. Prefer SITE_URL in a deployment: NEXT_PUBLIC_* is compiled into the
# bundle at build time, so it cannot be corrected without rebuilding, while
# SITE_URL is read by the running server and takes effect on restart. On Railway
# both may be left unset — RAILWAY_PUBLIC_DOMAIN is used automatically.
SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_CONSUMER_SITE_URL=https://cheezious.com
# Set to 1 on staging/preview deployments to emit noindex globally.
NEXT_PUBLIC_SEO_NOINDEX=0
NEXT_PUBLIC_ANALYTICS_ADAPTER=console

# --- CMS -------------------------------------------------------------------
NEXT_PUBLIC_CMS_API_URL=http://localhost:4000

# --- Seeding (development only) -------------------------------------------
SEED_ADMIN_EMAIL=admin@cheezious.local
SEED_ADMIN_PASSWORD=ChangeMe-First-Signin-2026

# --- End-to-end tests (development only) -----------------------------------
# The account `pnpm --filter @cheezious/api e2e:account` provisions and the
# Playwright suite signs in as. Both must be set for the suite to run; the
# password must satisfy the same policy the API enforces on everyone else.
E2E_EMAIL=e2e@cheezious.local
E2E_PASSWORD=
