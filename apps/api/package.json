{
  "name": "@cheezious/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "node esbuild.config.mjs",
    "start": "node dist/server.cjs",
    "worker:start": "node dist/worker.cjs",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run --passWithNoTests",
    "test:unit": "vitest run src/**/*.unit.test.ts",
    "worker": "dotenv -e ../../.env -- tsx src/worker.ts",
    "e2e:account": "dotenv -e ../../.env -- tsx src/scripts/e2e-account.ts"
  },
  "dependencies": {
    "@cheezious/auth": "workspace:*",
    "@cheezious/config": "workspace:*",
    "@cheezious/database": "workspace:*",
    "@cheezious/logger": "workspace:*",
    "@cheezious/page-builder": "workspace:*",
    "@cheezious/permissions": "workspace:*",
    "@cheezious/seo": "workspace:*",
    "@cheezious/utilities": "workspace:*",
    "@cheezious/validation": "workspace:*",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^4.2.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
