{
  "name": "@cheezious/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "push": "dotenv -e ../../.env -- prisma db push",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- tsx seed/index.ts",
    "build": "dotenv -e ../../.env -- prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "validate": "dotenv -e ../../.env -- prisma validate"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@cheezious/permissions": "workspace:*",
    "@cheezious/config": "workspace:*",
    "@cheezious/utilities": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "argon2": "^0.41.1",
    "dotenv-cli": "^8.0.0"
  }
}
