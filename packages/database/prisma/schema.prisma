// CONTACT AND FORMS
// =============================================================================

model ContactCategory {
  id          String             @id @default(cuid())
  key         ContactCategoryKey @unique
  name        String
  slug        String             @unique
  description String?
  /// Public instructions shown above the form ("for press enquiries, email …").
  publicInstructions String?
  /// Internal routing address. Never exposed through the public API.
  routingEmail String?
  formDefinitionId String?
  formDefinition   FormDefinition? @relation(fields: [formDefinitionId], references: [id], onDelete: SetNull)
  isEnabled   Boolean @default(true)
  sortOrder   Int     @default(0)

  submissions ContactSubmission[]

  @@map("contact_categories")
}

model ContactSubmission {
  id        String @id @default(cuid())
  reference String @unique

  categoryId String?
  category   ContactCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name    String
  email   String
  phone   String?
  subject String?
  message String
  city    String?

  consentGivenAt DateTime
  consentText    String

  status     ContactSubmissionStatus @default(NEW)
  assigneeId String?
  assignee   User?  @relation("ContactAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  ipHash    String?
  userAgent String?
  /// Populated by the spam heuristics; high scores are quarantined, not deleted.
  spamScore Float @default(0)
  retentionUntil DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  notesLog SubmissionNote[]

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@map("contact_submissions")
}

/// Internal notes attached to any submission queue. Always private.
model SubmissionNote {
  id       String @id @default(cuid())
  authorId String?
  author   User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body     String

  jobApplicationId String?
  jobApplication   JobApplication? @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  supplierSubmissionId String?
  supplierSubmission   SupplierSubmission? @relation(fields: [supplierSubmissionId], references: [id], onDelete: Cascade)
  propertySubmissionId String?
  propertySubmission   PropertySubmission? @relation(fields: [propertySubmissionId], references: [id], onDelete: Cascade)
  partnershipSubmissionId String?
  partnershipSubmission   PartnershipSubmission? @relation(fields: [partnershipSubmissionId], references: [id], onDelete: Cascade)
  contactSubmissionId String?
  contactSubmission   ContactSubmission? @relation(fields: [contactSubmissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([jobApplicationId])
  @@index([supplierSubmissionId])
  @@index([propertySubmissionId])
  @@index([contactSubmissionId])
  @@map("submission_notes")
}

model FormDefinition {
  id      String @id @default(cuid())
  key     String @unique
  name    String
  slug    String @unique
  purpose String?

  /// Where submissions are routed internally.
  recipientEmails String[] @default([])
  successMessage  String   @default("Thank you. Your submission has been received.")
  submitLabel     String   @default("Submit")
  isEnabled       Boolean  @default(true)
  /// Requires the honeypot + timing checks before accepting a submission.
  spamProtection  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fields      FormField[]
  submissions FormSubmission[]
  jobs        Job[]
  contactCategories ContactCategory[]

  @@map("form_definitions")
}

model FormField {
  id     String @id @default(cuid())
  formId String
  form   FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)

  type        FormFieldType
  name        String
  label       String
  placeholder String?
  helpText    String?
  isRequired  Boolean @default(false)
  /// Select/radio/checkbox choices: [{ value, label }].
  options     Json?
  /// Additional constraints: { minLength, maxLength, pattern, min, max, accept }.
  validation  Json?
  width       String  @default("full")
  sortOrder   Int     @default(0)

  @@unique([formId, name])
  @@index([formId, sortOrder])
  @@map("form_fields")
}

model FormSubmission {
  id     String @id @default(cuid())
  formId String
  form   FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)

  reference String @unique
  data      Json
  status    ContactSubmissionStatus @default(NEW)

  ipHash    String?
  userAgent String?
  spamScore Float @default(0)
  retentionUntil DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  files FormSubmissionFile[]

  @@index([formId, status, createdAt])
  @@map("form_submissions")
}

model FormSubmissionFile {
  id           String @id @default(cuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  assetId      String
  asset        MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fieldName    String
  createdAt    DateTime @default(now())

  @@index([submissionId])
  @@map("form_submission_files")
}

// =============================================================================
// SEARCH, CONTENT HEALTH, JOBS AND INTEGRATIONS
// =============================================================================

/// Denormalised search index. Backed by PostgreSQL full-text search today; the
/// shape deliberately matches what an external engine would need, so swapping in
/// OpenSearch later is an adapter change rather than a schema migration.
model SearchDocument {
  id     String @id @default(cuid())
  type   SearchDocumentType
  locale Locale

  entityId String
  title    String
  summary  String?
  /// Flattened body text used for matching.
  body     String
  url      String
  /// Free-form facets surfaced as search filters.
  section  String?
  category String?
  tags     String[] @default([])

  publishedAt DateTime?
  boost       Float    @default(1)

  /// Weighted tsvector maintained by a database trigger (see the
  /// `search_and_indexes` migration). Prisma cannot express tsvector natively;
  /// declaring it here keeps `prisma migrate` from treating it as drift.
  searchVector Unsupported("tsvector")?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([type, entityId, locale])
  @@index([locale, type])
  @@index([publishedAt])
  /// GIN index backing ranked full-text matching. Declared here (rather than only
  /// in SQL) so `prisma migrate dev` tracks it instead of proposing to drop it.
  @@index([searchVector(ops: raw("tsvector_ops"))], map: "search_documents_vector_idx", type: Gin)
  /// Trigram index for fuzzy title matching ("leadrship" -> "Leadership").
  @@index([title(ops: raw("gin_trgm_ops"))], map: "search_documents_title_trgm_idx", type: Gin)
  @@map("search_documents")
}

model ContentHealthIssue {
  id       String                 @id @default(cuid())
  type     ContentHealthIssueType
  severity ContentHealthSeverity  @default(WARNING)

  entityType String
  entityId   String
  entityLabel String
  locale     Locale
  /// Field or block the issue was detected on.
  field      String?
  detail     String?
  href       String?

  /// Set when an editor deliberately accepts the issue (with a reason).
  dismissedAt   DateTime?
  dismissedById String?
  dismissReason String?

  detectedAt DateTime @default(now())
  resolvedAt DateTime?

  @@unique([type, entityType, entityId, locale, field])
  @@index([type, resolvedAt])
  @@index([entityType, entityId])
  @@map("content_health_issues")
}

model PublishingJob {
  id     String              @id @default(cuid())
  kind   PublishingJobKind
  status PublishingJobStatus @default(PENDING)

  entityType String?
  entityId   String?
  payload    Json?

  runAt       DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?
  /// Prevents a scheduled publish from being enqueued twice.
  idempotencyKey String? @unique

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, runAt])
  @@index([entityType, entityId])
  @@map("publishing_jobs")
}

model Integration {
  id       String  @id @default(cuid())
  key      String  @unique
  name     String
  provider String
  isEnabled Boolean @default(false)
  /// Non-secret configuration only. Credentials live in environment variables.
  config   Json?
  lastSyncAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhooks Webhook[]

  @@map("integrations")
}

model Webhook {
  id            String  @id @default(cuid())
  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  name   String
  url    String
  events String[] @default([])
  /// HMAC signing secret reference. The value itself is stored encrypted at rest
  /// by the application layer, never in plaintext.
  secretRef String?
  isEnabled Boolean @default(true)

  lastDeliveryAt     DateTime?
  lastDeliveryStatus Int?
  failureCount       Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webhooks")
}

/// Short-lived tokens granting preview access to unpublished content.
model PreviewToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  entityType String
  entityId   String
  locale     Locale
  createdById String?
  expiresAt  DateTime
  usedCount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([expiresAt])
  @@map("preview_tokens")
}
