// =============================================================================
// Cheezious Corporate Digital Platform — data model
//
// Conventions used throughout:
//   • cuid() primary keys, `createdAt` / `updatedAt` on every mutable table.
//   • Authorship columns (`createdById`, `updatedById`, `publishedById`) are kept
//     on content so the CMS can always answer "who changed this, and when".
//   • Localisation uses a `translationGroupId`: every locale variant of the same
//     logical content shares one group id, which keeps slugs, SEO and blocks
//     fully localisable instead of forcing a shared English slug.
//   • Versioned content never carries a `published` boolean. It carries a
//     ContentStatus and a pointer to the ContentVersion the public site serves,
//     so editing a published page cannot change production until it is published.
//   • Soft deletion (`deletedAt`) is used wherever an accidental delete would
//     destroy institutional history.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Locale {
  en
  ur
}

/// Editorial workflow. Mirrors @cheezious/permissions `ContentStatus`.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum TranslationStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  PUBLISHED
  OUTDATED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  PUBLISH
  UNPUBLISH
  SCHEDULE
  CANCEL_SCHEDULE
  APPROVE
  REQUEST_CHANGES
  SUBMIT_FOR_REVIEW
  ARCHIVE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  ROLE_ASSIGNED
  ROLE_REVOKED
  PERMISSION_CHANGED
  SETTINGS_CHANGED
  MEDIA_UPLOADED
  MEDIA_DELETED
  EXPORT
  STATUS_CHANGED
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

/// Controls whether an asset may be served from the public media centre.
enum MediaVisibility {
  PUBLIC_DOWNLOAD
  CMS_ONLY
  RESTRICTED
}

