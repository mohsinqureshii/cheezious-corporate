  categoryId String?
  category   PartnershipCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  proposal String
  notes    String?

  consentGivenAt DateTime
  consentText    String

  status     PartnershipSubmissionStatus @default(NEW)
  assigneeId String?
  assignee   User?   @relation("PartnershipAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  ipHash    String?
  userAgent String?
