  @@index([submissionId])
  @@map("supplier_attachments")
}

model PropertySubmission {
  id        String @id @default(cuid())
  reference String @unique

  contactName String
  email       String
  phone       String
  company     String?

  cityId  String?
  cityName String
  area    String?
  address String
