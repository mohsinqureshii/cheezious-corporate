{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build:packages && pnpm --filter @cheezious/cms build",
    "watchPatterns": ["apps/cms/**", "packages/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @cheezious/cms start",
    "restartPolicyType": "ON_FAILURE"
  }
}
