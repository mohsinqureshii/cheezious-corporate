{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build:packages && pnpm --filter @cheezious/corporate-web build",
    "watchPatterns": ["apps/corporate-web/**", "packages/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @cheezious/corporate-web start",
    "restartPolicyType": "ON_FAILURE"
  }
}
